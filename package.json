{
  "name": "@danhachuel/thunderbolt",
  "version": "0.2.85",
  "description": "Thunderbolt — interface local para operação de canais faceless e motor MoneyPrinterTurbo",
  "license": "MIT",
  "main": "scripts/cli.mjs",
  "type": "module",
  "bin": {
    "thunderbolt": "scripts/cli.mjs"
  },
  "files": [
    "app/main.py",
    "app/modules/**/*.py",
    "hermes_ui/*.py",
    "integrations/*.py",
    "integrations/data/*.json",
    "scripts/*.mjs",
    "storage/blueprints/**/*.json",
    "storage/tiktok/prompts_master/**/*.md",
    "seed/prompt_masters/**/*.md",
    "seed/blueprints/**/*.json",
    "seed/skills/*.md",
    "seed/references/*.md",
    "README.md",
    "MANUAL-INSTALACAO.md",
    "THIRD-PARTY-NOTICES.md",
    "requirements.txt",
    "package.json"
  ],
  "scripts": {
    "start": "node scripts/cli.mjs",
    "check": "node scripts/cli.mjs --check",
    "pack:check": "npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
