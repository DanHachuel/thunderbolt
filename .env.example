# Copie este ficheiro para .env e preencha apenas os cookies da sua própria sessão Instagram.
# Nunca publique o ficheiro .env nem partilhe estes valores.
INSTAGRAM_SESSIONID=
INSTAGRAM_CSRFTOKEN=
INSTAGRAM_DS_USER_ID=
INSTAGRAM_MID=
INSTAGRAM_IG_DID=

# Aliases aceites pelo Thunderbolt, caso já use estes nomes:
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DS_USER_ID=
IG_MID=
IG_IG_DID=
