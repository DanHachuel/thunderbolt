# Opcional: o Thunderbolt funciona em modo público sem nenhuma conta Instagram autenticada.
# Só preencha estes cookies se quiser consultar endpoints privados/transparência da sua própria sessão.
# Nunca publique o ficheiro .env nem partilhe estes valores.
INSTAGRAM_SESSIONID=
INSTAGRAM_CSRFTOKEN=
INSTAGRAM_DS_USER_ID=
INSTAGRAM_MID=
INSTAGRAM_IG_DID=

# Aliases opcionais:
IG_SESSIONID=
IG_CSRFTOKEN=
IG_DS_USER_ID=
IG_MID=
IG_IG_DID=
